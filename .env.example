# Copy this file to .env and fill in. Vite only exposes vars prefixed with VITE_,
# so the API key below never reaches the browser.

# Server-side only: used by scripts/create-agent.mjs to design the voice and create the agent.
ELEVENLABS_API_KEY=

# Optional: reuse an existing voice instead of designing a new one.
# ELEVENLABS_VOICE_ID=

# Optional fallback agent for any character without an entry in src/data/agents.js.
VITE_ELEVENLABS_DEFAULT_AGENT_ID=
